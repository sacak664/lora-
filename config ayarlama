//==========================================================
// ANA MENU KONTROLU
//==========================================================

void processMainMenu()
{
  if(state != MAIN_MENU)
    return;

  if(!Serial.available())
    return;

  String input = Serial.readStringUntil('\n');
  input.trim();

  if(input=="1")
  {
    setNormalMode();
    return;
  }

  if(input=="2")
  {
    setConfigMode();
    return;
  }

  if(input=="3")
  {
    showSystemInfo();
    return;
  }

  Serial.println("Hatali Secim");
  showMainMenu();
}

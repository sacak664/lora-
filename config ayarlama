//==========================================================
// CRC HESABI
//==========================================================

byte calculateCRC(byte *buffer, byte length)
{
    byte crc = 0;

    for(byte i=0;i<length;i++)
    {
        crc ^= buffer[i];
    }

    return crc;
}
//==========================================================
// PAKET OLUSTUR
//==========================================================

void buildPacket(byte command, String text)
{
    txLength = 0;

    txPacket[txLength++] = DEST_ADDH;
    txPacket[txLength++] = DEST_ADDL;
    txPacket[txLength++] = cfg.CHANNEL;

    txPacket[txLength++] = command;

    byte len = text.length();

    txPacket[txLength++] = len;

    for(byte i=0;i<len;i++)
    {
        txPacket[txLength++] = text[i];
    }

    byte crc = calculateCRC(&txPacket[3],len+2);

    txPacket[txLength++] = crc;
}
//==========================================================
// PAKET GONDER
//==========================================================

void sendPacket(byte command, String text)
{
    buildPacket(command, text);

    Serial1.write(txPacket, txLength);

    Serial.print("TX -> ");

    for(byte i=0; i<txLength; i++)
    {
        if(txPacket[i] < 16)
            Serial.print("0");

        Serial.print(txPacket[i], HEX);
        Serial.print(" ");
    }

    Serial.println();

    lastActivity = millis();
}
